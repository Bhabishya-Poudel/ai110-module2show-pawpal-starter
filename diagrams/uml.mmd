classDiagram
    %% Replace the placeholders below with your actual classes, attributes, methods, and relationships.
    %% Keep this file updated so it matches your final implementation.

    class Pet {
        +String name
        +String species
        +String breed
        +int age
        +list~Task~ tasks
    }

    class Owner {
        +String name
        +int availableMinutes
        +String timePreferences
        +list~Pet~ pets
        +addPet(pet) void
        +addTask(pet, task) void
        +getAllTasks() list~Task~
    }

    class Task {
        +String title
        +int duration
        +String priority
        +boolean completed
        +String petName
        +String startTime
        +String reason
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +list~Task~ skipped
        +generatePlan() list~Task~
        +explainPlan() String
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
    Scheduler "1" --> "*" Task : plans
